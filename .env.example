NODE_ENV=development
PORT=4000
# Frontend origin(s), comma-separated when using multiple domains.
CLIENT_ORIGIN=http://localhost:5173

# Local development and automated tests use the built-in SQLite adapter.
# On Render, set DATABASE_PROVIDER=tidb and supply the TIDB_* variables below.
DATABASE_PROVIDER=sqlite
DATABASE_PATH=./data/seasonlens.sqlite

# TiDB Cloud Starter/Essential connection settings (backend only; never expose in VITE_* variables).
# Copy these exact values from TiDB Cloud > Connect > Node.js / MySQL.
# TIDB_HOST=your_tidb_host_from_connect_panel
# TIDB_PORT=4000
# TIDB_USER=your_tidb_username
# TIDB_PASSWORD=your_tidb_password
# TIDB_DATABASE=seasonlens
TIDB_ENABLE_SSL=true
# Optional; TiDB Cloud Starter normally works with Node's built-in trusted CA store.
# TIDB_CA_PATH=/path/to/ca.pem

NASA_POWER_BASE_URL=https://power.larc.nasa.gov/api/temporal/daily/point
NASA_POWER_TIMEOUT_MS=20000
NASA_POWER_CACHE_TTL_MS=900000
NASA_POWER_COMMUNITY=AG
DEFAULT_OBSERVATION_DAYS=30
